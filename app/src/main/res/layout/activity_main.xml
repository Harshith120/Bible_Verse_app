<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    xmlns:tools="http://schemas.android.com/tools"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:orientation="vertical"
    android:background="#F5F3FF"
    tools:context=".MainActivity">

    <!-- Top App Bar -->
    <com.google.android.material.appbar.MaterialToolbar
        android:id="@+id/topAppBar"
        android:layout_width="match_parent"
        android:layout_height="?attr/actionBarSize"
        android:background="#673AB7"
        android:elevation="4dp"
        app:title="Daily Bible Verse"
        app:titleCentered="true"
        app:titleTextColor="@android:color/white" />

    <ScrollView
        android:layout_width="match_parent"
        android:layout_height="match_parent"
        android:fillViewport="true">

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:gravity="center"
            android:orientation="vertical"
            android:padding="20dp">

            <TextView
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginBottom="16dp"
                android:text="Verse of the Day"
                android:textColor="#311B92"
                android:textSize="22sp"
                android:textStyle="bold" />

            <!-- Verse Card -->
            <com.google.android.material.card.MaterialCardView
                android:id="@+id/verseCard"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginHorizontal="8dp"
                android:layout_marginVertical="8dp"
                app:cardCornerRadius="20dp"
                app:cardElevation="6dp"
                app:strokeWidth="0dp">

                <LinearLayout
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:background="#4A148C"
                    android:orientation="vertical"
                    android:padding="24dp">

                    <!-- Top Row: Translation Tag & Bookmark -->
                    <RelativeLayout
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content">

                        <TextView
                            android:id="@+id/translationBadge"
                            android:layout_width="wrap_content"
                            android:layout_height="wrap_content"
                            android:layout_centerVertical="true"
                            android:background="#FFC107"
                            android:paddingHorizontal="12dp"
                            android:paddingVertical="4dp"
                            android:text="WEB"
                            android:textColor="#1A237E"
                            android:textSize="12sp"
                            android:textStyle="bold" />

                        <ImageButton
                            android:id="@+id/btnBookmark"
                            android:layout_width="40dp"
                            android:layout_height="40dp"
                            android:layout_alignParentEnd="true"
                            android:background="?attr/selectableItemBackgroundBorderless"
                            android:contentDescription="Bookmark Verse"
                            android:src="@android:drawable/btn_star_big_off"
                            app:tint="#FFC107" />
                    </RelativeLayout>

                    <!-- Quote Icon -->
                    <ImageView
                        android:layout_width="36dp"
                        android:layout_height="36dp"
                        android:layout_marginTop="12dp"
                        android:contentDescription="Quote"
                        android:src="@android:drawable/ic_menu_edit"
                        app:tint="#FFD54F" />

                    <!-- Verse Text -->
                    <TextView
                        android:id="@+id/tvVerseText"
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:layout_marginTop="12dp"
                        android:lineSpacingMultiplier="1.4"
                        android:text="&quot;For God so loved the world, that he gave his one and only Son, that whoever believes in him should not perish, but have eternal life.&quot;"
                        android:textColor="@android:color/white"
                        android:textSize="18sp"
                        android:textStyle="italic" />

                    <View
                        android:layout_width="match_parent"
                        android:layout_height="1dp"
                        android:layout_marginVertical="16dp"
                        android:background="#40FFFFFF" />

                    <!-- Reference and Actions -->
                    <RelativeLayout
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content">

                        <TextView
                            android:id="@+id/tvVerseReference"
                            android:layout_width="wrap_content"
                            android:layout_height="wrap_content"
                            android:layout_centerVertical="true"
                            android:text="John 3:16"
                            android:textColor="#FFD54F"
                            android:textSize="18sp"
                            android:textStyle="bold" />

                        <LinearLayout
                            android:layout_width="wrap_content"
                            android:layout_height="wrap_content"
                            android:layout_alignParentEnd="true"
                            android:orientation="horizontal">

                            <ImageButton
                                android:id="@+id/btnCopy"
                                android:layout_width="36dp"
                                android:layout_height="36dp"
                                android:background="?attr/selectableItemBackgroundBorderless"
                                android:contentDescription="Copy"
                                android:src="@android:drawable/ic_menu_share"
                                app:tint="@android:color/white" />

                        </LinearLayout>
                    </RelativeLayout>
                </LinearLayout>
            </com.google.android.material.card.MaterialCardView>

            <!-- Refresh Button -->
            <com.google.android.material.button.MaterialButton
                android:id="@+id/btnRefresh"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginTop="24dp"
                android:backgroundTint="#673AB7"
                android:paddingHorizontal="24dp"
                android:paddingVertical="12dp"
                android:text="Refresh Daily Verse"
                android:textColor="@android:color/white"
                app:cornerRadius="12dp"
                app:icon="@android:drawable/ic_popup_sync"
                app:iconTint="@android:color/white" />

        </LinearLayout>
    </ScrollView>
</LinearLayout>
